            _noise(x, z) {
                const s = this.seed;
                return Math.sin(x * 0.02 + s) * Math.cos(z * 0.02 + s) * this.maxHeight * 0.6 +
                       Math.sin(x * 0.05 + s * 2) * Math.cos(z * 0.05) * this.maxHeight * 0.3 +
                       Math.sin(x * 0.1) * Math.sin(z * 0.1) * this.maxHeight * 0.1;
            }
            heightAt(x, z) { return this._noise(x, z); }
            addTo(scene) { scene.add(this.mesh); return this; }
        }

        // Character3D
        class Character3D {
            constructor({ size = { x: 1, y: 2, z: 1 } } = {}) {
                this.mesh = null;
                this.mixer = null;
                this.actions = {};
                this.currentAction = null;
                this.size = size;
                this.position = new THREE.Vector3(0, 0, 0);
                this.loaded = false;
            }
            async loadModel(url) {
                return new Promise((resolve, reject) => {
                    const loader = new THREE.GLTFLoader();
                    loader.load(url, (gltf) => {
                        this.mesh = gltf.scene;
                        this.mesh.traverse(n => { if (n.isMesh) { n.castShadow = true; n.receiveShadow = true; } });
                        this.mixer = new THREE.AnimationMixer(this.mesh);
                        gltf.animations.forEach(clip => { this.actions[clip.name] = this.mixer.clipAction(clip); });
                        this.loaded = true;
                        resolve(this);
                    }, undefined, reject);
                });
            }
            usePlaceholder(color = 0x22d3ee) {
                const geo = new THREE.CapsuleGeometry(this.size.x / 2, this.size.y - this.size.x, 4, 8);
                const mat = new THREE.MeshStandardMaterial({ color });
                this.mesh = new THREE.Mesh(geo, mat);
                this.mesh.castShadow = true;
                this.loaded = true;
                return this;
            }
            play(name, { fadeTime = 0.2, loop = true } = {}) {
                const action = this.actions[name];
                if (!action) return;
                if (this.currentAction === action) return;
                if (this.currentAction) this.currentAction.fadeOut(fadeTime);
                action.reset().fadeIn(fadeTime).play();
                action.setLoop(loop ? THREE.LoopRepeat : THREE.LoopOnce);
                this.currentAction = action;
            }
            update(dt) { if (this.mixer) this.mixer.update(dt); if (this.mesh) this.mesh.position.copy(this.position); }
            addTo(scene) { if (this.mesh) scene.add(this.mesh); return this; }
        }

        // NPCAgent
        class NPCAgent {
            constructor(character3D, { speed = 3, sightRange = 15, attackRange = 2, patrolPoints = [] } = {}) {
                this.char = character3D;
                this.speed = speed;
                this.sightRange = sightRange;
                this.attackRange = attackRange;
                this.patrolPoints = patrolPoints;
                this.patrolIndex = 0;
                this.state = "idle";
                this.idleTimer = 0;
                this.onAttack = null;
            }
            update(dt, target) {
                const pos = this.char.position;
                const distToTarget = target ? pos.distanceTo(target.position) : Infinity;
                if (distToTarget <= this.attackRange) this.state = "attack";
                else if (distToTarget <= this.sightRange) this.state = "chase";
                else if (this.state === "chase" || this.state === "attack") this.state = "idle";

                switch (this.state) {
                    case "idle":
                        this.idleTimer += dt;
                        if (this.idleTimer > 2 && this.patrolPoints.length) { this.state = "patrol"; this.idleTimer = 0; }
                        this.char.play("idle");
                        break;
                    case "patrol": {
                        const p = this.patrolPoints[this.patrolIndex];
                        if (p) {
                            this._moveToward(p, dt);
                            if (pos.distanceTo(p) < 0.5) {
                                this.patrolIndex = (this.patrolIndex + 1) % this.patrolPoints.length;
                                this.state = "idle";
                            }
                        }
                        this.char.play("walk");
                        break;
                    }
                    case "chase":
                        if (target) this._moveToward(target.position, dt);
                        this.char.play("run");
                        break;
                    case "attack":
                        this.char.play("attack", { loop: false });
                        if (this.onAttack && target) this.onAttack(target);
                        break;
                }
            }
            _moveToward(targetPos, dt) {
                const pos = this.char.position;
                const dir = new THREE.Vector3().subVectors(targetPos, pos);
                dir.y = 0;
                const dist = dir.length();
                if (dist > 0.01) {
                    dir.normalize();
                    pos.x += dir.x * this.speed * dt;
                    pos.z += dir.z * this.speed * dt;
                    if (this.char.mesh) this.char.mesh.rotation.y = Math.atan2(dir.x, dir.z);
                }
            }
        }

        // NetworkClient
        class NetworkClient {
            constructor() {
                this.ws = null;
                this.connected = false;
                this.playerId = null;
                this.listeners = {};
                this.sendQueue = [];
            }
            connect(url) {
                return new Promise((resolve, reject) => {
                    try { this.ws = new WebSocket(url); } catch(e) { reject(e); return; }
                    this.ws.onopen = () => {
                        this.connected = true;
                        this.sendQueue.forEach(msg => this.ws.send(msg));
                        this.sendQueue = [];
                        resolve(this);
                    };
                    this.ws.onmessage = (event) => {
                        let data;
                        try { data = JSON.parse(event.data); } catch { return; }
                        if (data.type === "welcome") this.playerId = data.id;
                        this._emit(data.type, data);
                    };
                    this.ws.onclose = () => { this.connected = false; this._emit("disconnected", {}); };
                    this.ws.onerror = (err) => { this._emit("error", err); reject(err); };
                });
            }
            on(eventType, callback) { if (!this.listeners[eventType]) this.listeners[eventType] = []; this.listeners[eventType].push(callback); }
            _emit(eventType, data) { (this.listeners[eventType] || []).forEach(cb => cb(data)); }
            send(type, payload = {}) {
                const msg = JSON.stringify({ type, ...payload });
                if (this.connected) this.ws.send(msg);
                else this.sendQueue.push(msg);
            }
            sendPlayerState(position, rotation) {
                this.send("state", { x: position.x, y: position.y, z: position.z, ry: rotation });
            }
            disconnect() { if (this.ws) this.ws.close(); }
        }

        // Scene3D
        class Scene3D {
            constructor(canvas, { fogColor = 0x88ccee, fogNear = 30, fogFar = 250 } = {}) {
                this.scene = new THREE.Scene();
                this.scene.fog = new THREE.Fog(fogColor, fogNear, fogFar);
                this.scene.background = new THREE.Color(fogColor);

                this.camera = new THREE.PerspectiveCamera(70, canvas.clientWidth / canvas.clientHeight, 0.1, 1000);
                this.camera.position.set(0, 5, 10);

                this.renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
                this.renderer.shadowMap.enabled = true;
                this.renderer.setSize(canvas.clientWidth, canvas.clientHeight);

                const sun = new THREE.DirectionalLight(0xffffff, 1.2);
                sun.position.set(50, 80, 30);
                sun.castShadow = true;
                sun.shadow.mapSize.set(2048, 2048);
                sun.shadow.camera.left = -100;
                sun.shadow.camera.right = 100;
                sun.shadow.camera.top = 100;
                sun.shadow.camera.bottom = -100;
                this.scene.add(sun);
                this.scene.add(new THREE.AmbientLight(0x8899aa, 0.6));

                this.physics = new Physics3D();
                this.sound = new SoundManager();
                this.network = new NetworkClient();
                this.terrain = null;
                this.characters = [];
                this.npcs = [];

                window.addEventListener("resize", () => this._onResize(canvas));
            }
            createOpenWorld(options) {
                this.terrain = new OpenWorldTerrain(options).addTo(this.scene);
                this.physics.groundY = (x,z) => this.terrain.heightAt(x,z);
                return this.terrain;
            }
            addCharacter(character3D) {
                character3D.addTo(this.scene);
                this.characters.push(character3D);
                return character3D;
            }
            addNPC(npcAgent) {
                this.npcs.push(npcAgent);
                return npcAgent;
            }
            update(dt, playerCharacter) {
                const terrainFn = this.terrain ? (x,z) => this.terrain.heightAt(x,z) : null;
                this.physics.update(dt, terrainFn);
                for (const c of this.characters) c.update(dt);
                for (const n of this.npcs) n.update(dt, playerCharacter);
            }
            render() { this.renderer.render(this.scene, this.camera); }
            _onResize(canvas) {
                this.camera.aspect = canvas.clientWidth / canvas.clientHeight;
                this.camera.updateProjectionMatrix();
                this.renderer.setSize(canvas.clientWidth, canvas.clientHeight);
            }
        }

        // Добавляем всё в NeonEngineV7.ThreeD
        global.NeonEngineV7.ThreeD = {
            Scene3D,
            Physics3D,
            OpenWorldTerrain,
            Character3D,
            NPCAgent,
            SoundManager,
            NetworkClient,
            version: "1.0.0"
        };

        console.log('🧊 NeonEngine3D v1.0 подключен');
